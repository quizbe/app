{
	"name": "quizbe-app",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "npm run gen-auth && npm run gen-sql",
		"gen-auth": "bun x auth@latest generate --config src/lib/server/index.ts --output .svelte-kit/auth-schema.ts --yes",
		"gen-sql": "bunx drizzle-kit generate --name migration",
		"gen:auth": "bunx auth@latest generate --config src/lib/server/index.ts --output .svelte-kit/auth-schema.ts --yes && bunx drizzle-kit generate --dialect sqlite --schema .svelte-kit/auth-schema.ts --name auth",
		"gen:db": "bunx drizzle-kit generate --dialect sqlite --schema src/lib/schemas/database.ts --name database"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.0.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.0"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.22",
		"@electric-sql/pglite": "^0.5.3",
		"@iconify-json/ph": "^1.2.2",
		"@libsql/client": "^0.17.4",
		"@uploadthing/svelte": "^7.3.3",
		"better-auth": "^1.6.22",
		"bits-ui": "^2.18.1",
		"cloudflare": "^6.5.0",
		"dayjs": "^1.11.21",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"idb-keyval": "^6.2.5",
		"ofetch": "^1.5.1",
		"runed": "^0.37.1",
		"uid": "^2.0.2",
		"uisv": "^0.0.26",
		"unocss": "^66.7.3",
		"unstorage": "^1.17.5",
		"uploadthing": "^7.7.4",
		"valibot": "^1.4.1"
	}
}
